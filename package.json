{
    "name": "gemini-url-prompt",
    "version": "1.0.0",
    "type": "module",
    "description": "Gemini URL Prompt - 自動讀取網址參數並填入 Google Gemini 對話框",
    "scripts": {
        "build": "esbuild src/content.ts --bundle --outfile=dist/content.js --format=iife --target=es2020 && npm run copy:manifest",
        "copy:manifest": "node -e \"require('fs').copyFileSync('manifest.dist.json', 'dist/manifest.json')\"",
        "watch": "esbuild src/content.ts --bundle --outfile=dist/content.js --format=iife --target=es2020 --watch",
        "clean": "rimraf dist dist-test",
        "typecheck": "tsc --noEmit",
        "build:test": "tsc -p tsconfig.test.json",
        "test": "npm run build:test && node --test tests/*.test.mjs"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.287",
        "esbuild": "^0.24.2",
        "rimraf": "^6.0.1",
        "typescript": "^5.7.2"
    },
    "keywords": [
        "chrome-extension",
        "gemini",
        "typescript"
    ],
    "author": "",
    "license": "MIT"
}

